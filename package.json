{
  "name": "schedule-manager-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "lint": "ng lint --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:types": "openapi-typescript ../api/specs/001-online-scheduling-api/contracts/openapi.yaml -o src/app/core/api/schema.gen.ts",
    "e2e": "playwright test",
    "typecheck": "ngc -p tsconfig.app.json --noEmit"
  },
  "private": true,
  "packageManager": "npm@11.20.0",
  "dependencies": {
    "@angular/cdk": "22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@lucide/angular": "1.81.0",
    "jwt-decode": "4.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@axe-core/playwright": "4.14.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.1",
    "angular-eslint": "22.8.0",
    "autoprefixer": "10.7.0",
    "eslint": "^10.14.0",
    "jsdom": "^31.0.0",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.33",
    "prettier": "^3.8.1",
    "tailwindcss": "3.4.19",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
